{
  "name": "valentyna-massage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "serve .output/public --listen tcp://127.0.0.1:4173 --no-clipboard",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nuxt prepare && eslint . && npm run format:check",
    "lint:fix": "nuxt prepare && eslint . --fix && npm run format",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "embla-carousel-vue": "8.6.0",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "serve": "14.2.8",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  }
}
